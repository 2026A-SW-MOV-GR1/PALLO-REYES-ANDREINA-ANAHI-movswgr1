<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        FASE 1: Permiso de internet.
        Sin esta línea, HttpURLConnection lanza java.net.SocketException
        o UnknownHostException en tiempo de ejecución. No pide permiso
        al usuario (normal protection level); solo debe declararse aquí.
        Posición: ANTES de <application>, dentro de <manifest>.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedSeguridad">

        <!--
            Esta <activity> ya existe en el proyecto limpio de Android Studio.
            No es necesario modificarla — se incluye aquí para referencia completa.
            android:exported="true" es obligatorio en API 31+ cuando hay intent-filter.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>